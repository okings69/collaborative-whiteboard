@{
    ViewData["Title"] = "Something went wrong";
}

<main class="error-shell">
    <div class="error-card">
        <p class="eyebrow">Application Error</p>
        <h1>Boardspace hit an unexpected issue.</h1>
        <p>Reload the page or go back to the boards list. If the problem persists, restart the application.</p>
        <a class="button-secondary" asp-controller="Boards" asp-action="Index">Back to boards</a>
    </div>
</main>
